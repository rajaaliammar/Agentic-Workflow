# =============================================================================
# Agentic-Workflow — Enterprise Environment Configuration
# Copy to .env and fill in production values. Never commit .env.
# =============================================================================

# Application
APP_NAME=Agentic-Workflow
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false
DATA_DIR=data

# LLM Provider (groq | openai)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# OpenAI (when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.3

# Firecrawl
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key

# Gmail API (OAuth2)
GMAIL_CREDENTIALS_PATH=credentials/credentials.json
GMAIL_TOKEN_PATH=credentials/token.json
GMAIL_SENDER_EMAIL=your-email@gmail.com

# Lead Generation Defaults
DEFAULT_INDUSTRY=B2B SaaS
DEFAULT_LOCATION=United States
MAX_LEADS_PER_RUN=10
SCRAPE_TIMEOUT_SECONDS=30
MIN_QUALIFICATION_SCORE=6.0

# Outreach
OUTREACH_FROM_NAME=Your Name
OUTREACH_FROM_COMPANY=Your Company
OUTREACH_FRAMEWORK=PAS
DRY_RUN=true

# HITL
REQUIRE_HUMAN_APPROVAL=true
